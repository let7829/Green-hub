local function bringLonecave()
    _G.AbortAction = false
    local tree = lonecaveTree()
    if not tree then notify("Lonecave", "Lonecave tree not found", 3) return end
    local stats = getAxStats("EndTimesAxe", "LoneCave")
    if not stats then notify("Lonecave", "No axe stats", 3) return end

    local _, _, startHrp = aliveChar()
    if not startHrp then notify("Lonecave", "No character", 2) return end
    local curpos = startHrp.CFrame

    local newLog
    local con = workspace.LogModels.ChildAdded:Connect(function(l)
        local o = l:WaitForChild("Owner", 2)
        if o and o.Value == LocalPlayer then newLog = l end
    end)

    local fails = 0
    while not newLog and not _G.AbortAction do
        local char, hum, hrp = aliveChar()
        if not char then
            task.wait(1)
        else
            if not findEndTimesAxe(char) then
                local dropped = droppedEndTimesAxe()
                if dropped then pickupAxe(dropped) end
                local inPack = findEndTimesAxe(LocalPlayer.Backpack)
                if inPack and aliveChar() then
                    aliveChar():FindFirstChildOfClass("Humanoid"):EquipTool(inPack)
                    task.wait(0.3)
                end
            end

            char, hum, hrp = aliveChar()
            local ax = char and findEndTimesAxe(char)
            if not ax then
                fails += 1
                if fails > 5 then
                    notify("Lonecave", "Could not get the EndTimesAxe back", 3)
                    break
                end
                task.wait(1)
            else
                fails = 0
                local sc = treeStandCF(tree)
                if sc then hrp.CFrame = sc end
                task.wait(0.25)

                local deadline = tick() + 60
                repeat
                    local c = aliveChar()
                    local a = c and findEndTimesAxe(c)
                    if not a then break end
                    ReplicatedStorage.Interaction.RemoteProxy:FireServer(tree.CutEvent, {
                        tool = a, height = 0.3, faceVector = Vector3.new(1, 0, 0), sectionId = 1,
                        hitPoints = stats.Damage, cooldown = stats.SwingCooldown, cuttingClass = "Axe",
                    })
                    task.wait(stats.SwingCooldown)
                until newLog or _G.AbortAction or tick() > deadline
            end
        end
    end
    con:Disconnect()

    if not newLog then
        local c = aliveChar()
        if c then c.HumanoidRootPart.CFrame = curpos end
        notify("Lonecave", _G.AbortAction and "Aborted" or "Stopped", 2)
        return
    end

    task.wait(0.15)
    task.spawn(function()
        for _ = 1, 60 do
            ReplicatedStorage.Interaction.ClientIsDragging:FireServer(newLog)
            task.wait()
        end
    end)
    task.wait(0.1)

    newLog.PrimaryPart = newLog.WoodSection
    for _ = 1, 60 do
        newLog.PrimaryPart.Velocity = Vector3.zero
        newLog:PivotTo(curpos)
        task.wait()
    end

    local char = LocalPlayer.Character
    if char then
        char.Humanoid:UnequipTools()
        task.wait()
        char.Head:Destroy()
    end
    LocalPlayer.CharacterAdded:Wait()
    task.wait(1.5)

    local newHrp = LocalPlayer.Character:WaitForChild("HumanoidRootPart")
    newHrp.CFrame = newLog.WoodSection.CFrame
    notify("Lonecave", "Lonecave brought", 3)
end

