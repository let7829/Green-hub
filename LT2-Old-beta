        else
            local ax = getAxe()
            if not ax or not aliveChar() then
                task.wait(1)
            else
                local sc = treeStandCF(tree)
                local glue = RunService.Heartbeat:Connect(function()
                    local _, _, r = aliveChar()
                    if r then r.CFrame = sc end
                end)
                task.wait(0.25)
                local chopStart = tick()
                local last = 0
                while not newLog and not _G.AbortAction and tick() - chopStart < 3 do
                    local c = aliveChar()
                    local a = c and findEndTimesAxe(c)
                    if not a then break end
                    if tick() - last >= stats.SwingCooldown then
                        ReplicatedStorage.Interaction.RemoteProxy:FireServer(tree.CutEvent, {
                            tool = a, height = 0.3, faceVector = Vector3.new(1, 0, 0), sectionId = 1,
                            hitPoints = stats.Damage, cooldown = stats.SwingCooldown, cuttingClass = "Axe",
                        })
                        last = tick()
                    end
                    task.wait()
                end
                glue:Disconnect()
                if not newLog and not _G.AbortAction and tick() - chopStart >= 3 and aliveChar() then
                    runSafeSuicide()
                    task.wait(6)
                end
            end
        end
    end
    con:Disconnect()

    if not newLog then
        local _, _, r = aliveChar()
        if r then r.CFrame = curpos end
        notify("Lonecave", _G.AbortAction and "Aborted" or "Stopped", 2)
        return
    end

    task.wait(0.2)
    local waited = tick()
    while not aliveChar() and tick() - waited < 10 do task.wait(0.2) end
    local _, _, hrp = aliveChar()
    if hrp and newLog.Parent then
        local part = newLog:FindFirstChild("WoodSection") or newLog:FindFirstChildWhichIsA("BasePart")
        if part then hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0) end
        task.wait(0.2)
    end
    for _ = 1, 60 do
        if _G.AbortAction then break end
        ReplicatedStorage.Interaction.ClientIsDragging:FireServer(newLog)
        newLog:PivotTo(curpos)
        task.wait()
    end
    local _, _, r2 = aliveChar()
    if r2 then r2.CFrame = curpos end
    notify("Lonecave", "Lonecave brought", 3)
end

