local onScreenBtns = {}
local savedPos = {}
local activePress

local function onScreenState(item)
    local o = Options[item.Key]
    return o and o.Value == true
end

local function toggleFunction(item)
    local o = Options[item.Key]
    if o then o:SetValue(not o.Value) end
end

local function matches(p, input)
    if p.input.UserInputType == Enum.UserInputType.MouseButton1 then
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseMovement
    end
    return input == p.input
end

local function bindPress(btn, item)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if activePress then return end
        local press = {
            btn = btn, item = item, input = input, dragging = false,
            start = input.Position, origin = btn.Position,
        }
        activePress = press
        task.delay(0.2, function()
            if activePress == press then press.dragging = true end
        end)
    end)
end

track(UIS.InputChanged:Connect(function(input)
    local p = activePress
    if not p or not p.dragging or not matches(p, input) then return end
    local d = input.Position - p.start
    p.btn.Position = UDim2.new(
        p.origin.X.Scale, p.origin.X.Offset + d.X,
        p.origin.Y.Scale, p.origin.Y.Offset + d.Y
    )
end))

track(UIS.InputEnded:Connect(function(input)
    local p = activePress
    if not p or not matches(p, input) then return end
    activePress = nil
    if not p.dragging then toggleFunction(p.item) end
end))

local function createOnScreenButton(item, index)
    local btn = Instance.new("TextButton")
    btn.Name = "OS_" .. item.Key
    btn.Size = UDim2.fromOffset(140, 40)
    btn.Position = savedPos[item.Key] or UDim2.new(0, 20, 0.3, 0)
    btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    btn.AutoButtonColor = false
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Text = item.Label .. ": Off"
    btn.Parent = onScreenGui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = item.Color
    stroke.Thickness = 2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    bindPress(btn, item)
    return btn
end

local function setOnScreenVisible(index, item, show)
    local btn = onScreenBtns[item.Key]
    if show then
        if not btn then
            btn = createOnScreenButton(item, index)
            onScreenBtns[item.Key] = btn
        end
        btn.Visible = true
    elseif btn then
        savedPos[item.Key] = btn.Position
        if activePress and activePress.btn == btn then activePress = nil end
        btn.Visible = false
    end
end

