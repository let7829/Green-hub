        local itemName = obj:WaitForChild("ItemName", 1)
        local purchased = obj:WaitForChild("PurchasedBoxItemName", 1)
        if owner and owner.Value == LocalPlayer and folder
            and ((itemName and itemName.Value == folder.Name) or (purchased and purchased.Value == folder.Name)) then
            bought = obj
        end
    end)

    dragTo(item, counter.CFrame + Vector3.new(0, counter.Size.Y * item.Main.Size.Y / 2, 0))

    local tries = 0
    repeat
        task.wait()
        tries += 1
        if npcName and ids[npcName.Name] then
            pcall(function()
                NPCDialog.PlayerChatted:InvokeServer({ID = ids[npcName.Name]}, "ConfirmPurchase")
            end)
        end
    until bought or tries > 40 or _G.AbortAction

    conn:Disconnect()

    if bought then
        local bHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if bHrp then
            bHrp.CFrame = bought:GetPivot() + Vector3.new(0, 5, 0)
            task.wait(0.3)
        end
        dragTo(bought, startCF)
        notify("Buy", "Bought " .. name, 3)
    else
        notify("Buy", "Purchase did not go through", 3)
    end
    hrp.CFrame = startCF
    return bought ~= nil
end

