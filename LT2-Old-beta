local hubCache
local function getHub()
    if hubCache and hubCache.Parent then return hubCache end
    for _, parent in ipairs({game:GetService("CoreGui"), LocalPlayer:WaitForChild("PlayerGui")}) do
        for _, gui in ipairs(parent:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, d in ipairs(gui:GetDescendants()) do
                    if d:IsA("TextLabel") and d.Text:find("Green Hub") then
                        hubCache = gui
                        return gui
                    end
                end
            end
        end
    end
end

local controlsSetup = false
local function setupControls(root)
    if controlsSetup or not root then return end
    controlsSetup = true
    local Controls = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule")):GetControls()
    track(root.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            Controls:Disable()
        end
    end))
    track(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            Controls:Enable()
        end
    end))
end

local function styleHub()
    local hub = getHub()
    if not hub then return end

    local function round(obj, radius)
        if obj:IsA("GuiObject") and not obj:FindFirstChildOfClass("UICorner") then
            Instance.new("UICorner", obj).CornerRadius = UDim.new(0, radius)
        end
    end

    for _, d in ipairs(hub:GetDescendants()) do
        if d:IsA("Frame") then
            if d.AbsoluteSize.X > 400 then
                if _G.ForceBlack then d.BackgroundColor3 = Color3.new(0, 0, 0) end
                d.BackgroundTransparency = _G.HubTransparent and 0.5 or 0
                round(d, 6)
            elseif d.BackgroundTransparency < 1 then
                round(d, 6)
            end
        elseif d:IsA("TextButton") then
            d.BackgroundTransparency = 1
            round(d, 6)
        end
    end

    local root
    for _, c in ipairs(hub:GetChildren()) do
        if c:IsA("GuiObject") and (not root or c.AbsoluteSize.X > root.AbsoluteSize.X) then
            root = c
        end
    end
    if root then
        round(root, 6)
        root.ClipsDescendants = true
        setupControls(root)
    end
end

local function filterRows(q)
    local hub = getHub()
    if not hub then return end
    q = string.lower(q)
    for _, page in ipairs(hub:GetDescendants()) do
        if page:IsA("ScrollingFrame") then
            for _, row in ipairs(page:GetChildren()) do
                if row:IsA("GuiObject") then
                    local hasInput = row:FindFirstChildWhichIsA("TextBox", true) ~= nil
                    local text = ""
                    for _, t in ipairs(row:GetDescendants()) do
                        if (t:IsA("TextLabel") or t:IsA("TextButton")) and t.Text ~= "" then
                            text = text .. " " .. t.Text
                        end
                    end
                    if q == "" or hasInput or text == "" then
                        row.Visible = true
                    else
                        row.Visible = string.find(string.lower(text), q, 1, true) ~= nil
                    end
                end
            end
        end
    end
end

local searchHooked = false
local function hookSearch()
    if searchHooked then return end
    local hub = getHub()
    if not hub then return end
    for _, d in ipairs(hub:GetDescendants()) do
        if d:IsA("TextBox") and string.find(string.lower(d.PlaceholderText), "search") then
            searchHooked = true
            track(d:GetPropertyChangedSignal("Text"):Connect(function()
                filterRows(d.Text)
            end))
            return
        end
    end
end

task.spawn(function()
    task.wait(1)
    while _G.MasterActive do
        pcall(styleHub)
        pcall(hookSearch)
        task.wait(1)
    end
end)

