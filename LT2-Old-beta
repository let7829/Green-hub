local function treeStandCF(tree)
    local low, lowY = nil, math.huge
    for _, p in ipairs(tree:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide and p.Position.Y < lowY then
            low, lowY = p, p.Position.Y
        end
    end
    if low then return CFrame.new(low.Position + Vector3.new(4, 2, 0)) end
    return CFrame.new(tree:GetPivot().Position + Vector3.new(5, 3, 0))
end

local function bringWood(woodType)
    local cooper = LocalPlayer
    local curpos = cooper.Character.HumanoidRootPart.CFrame
    local target = getTreeOfClass(woodType)
    local ax = getEquippedOrBackpackAxe()
    if not (target and ax) then
        notify("Wood", "No tree or axe found", 3)
        return
    end
    notify("Wood", "Bringing " .. woodType .. "...")
    local stats = getAxStats(ax.ToolName.Value, woodType)
    if not stats then
        notify("Wood", "No axe stats for " .. ax.ToolName.Value, 3)
        return
    end
    local newLog
    local con = workspace.LogModels.ChildAdded:Connect(function(l)
        local o = l:WaitForChild("Owner", 2)
        if o and o.Value == cooper then newLog = l end
    end)
    local sc = treeStandCF(target)
    local lp = RunService.Heartbeat:Connect(function()
        local r = cooper.Character and cooper.Character:FindFirstChild("HumanoidRootPart")
        if r then r.CFrame = sc end
    end)
    repeat
        ReplicatedStorage.Interaction.RemoteProxy:FireServer(target.CutEvent, {
            tool = ax, height = 0.3, faceVector = Vector3.new(1, 0, 0), sectionId = 1,
            hitPoints = stats.Damage, cooldown = stats.SwingCooldown, cuttingClass = "Axe",
        })
        task.wait(stats.SwingCooldown)
    until newLog ~= nil or _G.AbortAction
    lp:Disconnect()
    con:Disconnect()
    if not newLog then
        cooper.Character.HumanoidRootPart.CFrame = curpos
        notify("Wood", "Aborted", 2)
        return
    end
    task.wait(0.2)
    for i = 1, 60 do
        if _G.AbortAction then break end
        ReplicatedStorage.Interaction.ClientIsDragging:FireServer(newLog)
        newLog:PivotTo(curpos)
        task.wait()
    end
    cooper.Character.HumanoidRootPart.CFrame = curpos
    notify("Wood", woodType .. " brought")
end

