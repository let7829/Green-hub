local function findTree(class)
    for _, region in ipairs(workspace:GetChildren()) do
        if region.Name == "TreeRegion" then
            for _, m in ipairs(region:GetChildren()) do
                if m:FindFirstChild("TreeClass") and m.TreeClass.Value == class
                    and (not m:FindFirstChild("Owner") or m.Owner.Value == nil) then
                    return m
                end
            end
        end
    end
end

local function standCF(tree)
    local low, lowY = nil, math.huge
    for _, p in ipairs(tree:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide and p.Position.Y < lowY then
            low, lowY = p, p.Position.Y
        end
    end
    if low then return CFrame.new(low.Position + Vector3.new(4, 2, 0)) end
    return CFrame.new(tree:GetPivot().Position + Vector3.new(5, 3, 0))
end

local function hop()
    if not queue_on_teleport then return false end
    local ok, body = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)
    if not ok then return false end
    local okD, decoded = pcall(function() return HttpService:JSONDecode(body) end)
    if not okD then return false end
    local options = {}
    for _, s in ipairs(decoded.data or {}) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then table.insert(options, s.id) end
    end
    if #options == 0 then return false end
    if not queued then
        queued = true
        local cfg = string.format("{tree=%q,loadHub=%s,tpTree=%s,hubUrl=%q,wall=%q}",
            C.tree, tostring(C.loadHub), tostring(C.tpTree), C.hubUrl, C.wall)
        queue_on_teleport((C.wall ~= "" and (C.wall .. "\n") or "")
            .. "_G.GH_CFG = " .. cfg .. "\n"
            .. "_G.GH_SRC = " .. string.format("%q", _G.GH_SRC) .. "\n"
            .. "loadstring(_G.GH_SRC)()")
    end
    TeleportService:TeleportToPlaceInstance(game.PlaceId, options[math.random(#options)], LocalPlayer)
    return true
end

if not C.fromHub then
    local t = tick()
    repeat task.wait(0.1) until workspace:FindFirstChild("TreeRegion") or tick() - t > 4
    task.wait(0.5)
end

while not _G.GH_STOP do
    local tree = findTree(C.tree)
    if tree then
        pcall(delfile, FILE)
        say("Green Hub", C.tree .. " tree found!")
        if C.tpTree then
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            if hrp then hrp.CFrame = standCF(tree) end
        end
        if C.loadHub and not C.fromHub then
            loadstring(game:HttpGet(C.hubUrl))()
        end
        return
    end
    say("Search", "No " .. C.tree .. " here, hopping...")
    if not hop() then
        say("Search", "No servers or queue_on_teleport unavailable")
        return
    end
    task.wait(10)
end
]=====]

local function stopSearch()
    hopping = false
    _G.GH_STOP = true
    pcall(delfile, SEARCH_FILE)
end

local function runSearch(class)
    hopping = true
    _G.GH_STOP = false
    _G.GH_SRC = SEARCH_BODY
    _G.GH_CFG = {
        tree = class,
        loadHub = Options.SearchLoadHub.Value,
        tpTree = Options.SearchTeleport.Value,
        hubUrl = HUB_URL,
        wall = WALLHOP_SCRIPT,
