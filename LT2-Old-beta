local function flyDirection(cam)
    local dir = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
    local controls = getFlyControls()
    if controls then
        local mv = controls:GetMoveVector()
        if mv.Magnitude > 0.05 then
            dir += cam.CFrame.RightVector * mv.X + cam.CFrame.LookVector * -mv.Z
        end
    end
    return dir
end

local function makeMover(getRoot, getSpeed, useGyro)
    local m = {}
    function m.stop()
        if m.conn then m.conn:Disconnect() m.conn = nil end
        if m.bv then m.bv:Destroy() m.bv = nil end
        if m.bg then m.bg:Destroy() m.bg = nil end
        if m.platform and m.platform.Parent then m.platform.PlatformStand = false end
        m.platform = nil
    end
    function m.start()
        if m.conn then return true end
        local root = getRoot()
        if not root then return false end
        m.bv = Instance.new("BodyVelocity")
        m.bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        m.bv.Velocity = Vector3.zero
        m.bv.Parent = root
        if useGyro then
            m.bg = Instance.new("BodyGyro")
            m.bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            m.bg.P = 9000
            m.bg.Parent = root
            local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.PlatformStand = true
                m.platform = hum
            end
        end
        m.conn = RunService.RenderStepped:Connect(function()
            if getRoot() ~= root or not root.Parent then m.stop() return end
            if m.bv.Parent ~= root then m.bv.Parent = root end
            if m.bg and m.bg.Parent ~= root then m.bg.Parent = root end
            if m.platform and m.platform.Parent and not m.platform.PlatformStand then
                m.platform.PlatformStand = true
            end
            local cam = workspace.CurrentCamera
            local dir = flyDirection(cam)
            m.bv.Velocity = dir.Magnitude > 0 and dir.Unit * getSpeed() or Vector3.zero
            if m.bg then m.bg.CFrame = cam.CFrame end
        end)
        return true
    end
    return m
end

