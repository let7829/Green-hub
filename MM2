local killAllActive = false
local function actionKillAll()
    if killAllActive then return end
    killAllActive = true
    local char = LocalPlayer.Character
    if not char then
        killAllActive = false
        return
    end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        notify("Kill All", "You need a knife", 2)
        killAllActive = false
        return
    end
    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("BasePart")
    if not handle then
        killAllActive = false
        return
    end

    local visualizer = Instance.new("Part")
    visualizer.BrickColor = BrickColor.Red()
    visualizer.Transparency = 0.8
    visualizer.Anchored = true
    visualizer.CanCollide = false
    visualizer.Shape = Enum.PartType.Ball
    visualizer.Material = Enum.Material.ForceField
    visualizer.CastShadow = false
    visualizer.Size = Vector3.new(25, 25, 25)
    visualizer.Parent = workspace

    local function onHit(hit, h)
        local c = hit.Parent
        local humanoid = c and c:FindFirstChildOfClass("Humanoid")
        if humanoid and c.Name ~= LocalPlayer.Name then
            for _, part in pairs(c:GetChildren()) do
                if part:IsA("BasePart") then
                    pcall(firetouchinterest, part, h, 0)
                    pcall(firetouchinterest, part, h, 1)
                end
            end
        end
    end

    local reach = KillAuraRange
    local frameCounter = 0

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not tool or not tool:IsDescendantOf(workspace) or not handle or not handle.Parent then
            conn:Disconnect()
            visualizer:Destroy()
            killAllActive = false
            return
        end
        pcall(function() visualizer.CFrame = handle.CFrame end)
        frameCounter = frameCounter + 1
        if frameCounter % 3 ~= 0 then return end
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer then
                local hrp = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local mag = (hrp.Position - handle.Position).Magnitude
                    if mag <= reach then
                        onHit(hrp, handle)
                    end
                end
            end
        end
    end)

    task.delay(2, function()
        if conn then conn:Disconnect() end
        visualizer:Destroy()
        killAllActive = false
    end)

    notify("Kill All", "Killing all nearby", 2)
end

local function actionShootMurder()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    local localRole = RoleCache[LocalPlayer]
    if localRole ~= "Sheriff" then
        if not (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or LocalPlayer.Backpack:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Revolver")) then
            notify("Shoot Murder", "You must be the sheriff and have a gun!", 2)
            return
        end
    end

    local murderer = GetMurdererV1()
    if not murderer then
        notify("Shoot Murder", "No murderer found!", 2)
        return
    end

    local murdererHrp = murderer:FindFirstChild("HumanoidRootPart")
    if not murdererHrp then return end

    local gun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or LocalPlayer.Backpack:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Revolver")
    if not gun then
        notify("Shoot Murder", "Grabbing gun...", 2)
        actionPickupGun()
        task.wait(1)
        gun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or LocalPlayer.Backpack:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Revolver")
        if not gun then
            notify("Shoot Murder", "Failed to grab gun.", 2)
            return
        end
    end

    local originalCFrame = hrp.CFrame
    hrp.CFrame = murdererHrp.CFrame * CFrame.new(0, 0, 6)
    task.wait(0.1)

    if gun.Parent == LocalPlayer.Backpack then
        hum:EquipTool(gun)
        task.wait(0.2)
    end

    hrp.CFrame = CFrame.new(hrp.Position, murdererHrp.Position)
    task.wait(0.1)

    pcall(function()
        if gun.Activate then
            gun:Activate()
        end
        local fireRemote = gun:FindFirstChildWhichIsA("RemoteEvent") or gun:FindFirstChild("Fire")
        if fireRemote then
            fireRemote:FireServer()
        end
    end)

    task.wait(0.5)
    
    if hrp and hrp.Parent then
        hrp.CFrame = originalCFrame
    end

    notify("Shoot Murder", "Fired at murderer!", 2)
end

local function actionCoinGrab()
    local count = 0
    while isAlive() do
        local entity = getNextUncollectedEntity()
        if not entity then break end
        if walkToCoin(entity) then
            count = count + 1
        end
        task.wait(0.2)
        if count > 50 then break end
    end
    if count > 0 then
        notify("Coin Grabber", "Collected " .. count .. " coin(s)", 2)
    else
        notify("Coin Grabber", "No uncollected coins", 2)
    end
end

