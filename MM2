local function isCoinObject(obj)
    if not obj then return false end
    if obj.Name == "Coin" or obj.Name == "Coin_Server" then return true end
    if obj.Parent and (obj.Parent.Name == "Coin_Server" or obj.Parent.Name == "Coin") then return true end
    local anc = obj:FindFirstAncestor("Coin_Server")
    if anc then return true end
    return false
end

local coinEntityCache = nil
local function invalidateCoinCache()
    coinEntityCache = nil
end
local function getCoinEntities()
    if coinEntityCache then return coinEntityCache end
    local entities = {}
    local seen = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if isCoinObject(obj) and obj:IsA("BasePart") then
            local ancestor = obj:FindFirstAncestor("Coin_Server")
            local key = ancestor or obj
            if not seen[key] then
                seen[key] = true
                table.insert(entities, {model = ancestor, part = obj, key = key})
            end
        end
    end
    coinEntityCache = entities
    return entities
end
workspace.DescendantAdded:Connect(function(obj)
    if obj.Name == "Coin_Server" or obj.Name == "Coin" then
        invalidateCoinCache()
    end
end)
workspace.DescendantRemoving:Connect(function(obj)
    if obj.Name == "Coin_Server" or obj.Name == "Coin" then
