local flyConn, bodyVel, bodyGyr
local function StartFly()
    if flyConn then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    hum.PlatformStand = true
    bodyVel = Instance.new("BodyVelocity", hrp)
    bodyVel.Velocity = Vector3.zero
    bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyGyr = Instance.new("BodyGyro", hrp)
    bodyGyr.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bodyGyr.P = 5000
    bodyGyr.D = 200
    local smoothedVel = Vector3.zero
    local controlsRef = nil
    pcall(function()
        controlsRef = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule")):GetControls()
    end)
    flyConn = RunService.Heartbeat:Connect(function(dt)
        if not FlyEnabled then return end
        if not bodyVel or not bodyVel.Parent or not bodyGyr or not bodyGyr.Parent then
            StopFly()
            return
        end
        local cam = workspace.CurrentCamera
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if not hum then return end

        local md = hum.MoveDirection
        if md.Magnitude < 0.1 and controlsRef then
            local ok2, mv = pcall(function() return controlsRef:GetMoveVector() end)
            if ok2 and mv and mv.Magnitude > 0.1 then
                md = mv
            end
        end

        local targetVel = Vector3.zero
        if md.Magnitude > 0.1 then
            local camLook = cam.CFrame.LookVector
            camLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
            local camRight = cam.CFrame.RightVector
            camRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
            local dir = (camRight * md.X + camLook * (-md.Z))
            if dir.Magnitude > 0.1 then
                targetVel = dir.Unit * FlySpeedVal * md.Magnitude
            end
            local pitch = md.Z * cam.CFrame.LookVector.Y * FlySpeedVal
            targetVel = targetVel + Vector3.new(0, pitch, 0)
        end

        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            targetVel = targetVel + Vector3.new(0, FlySpeedVal, 0)
        end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
            targetVel = targetVel - Vector3.new(0, FlySpeedVal, 0)
        end

        local alpha = math.clamp(dt * 12, 0, 1)
        smoothedVel = smoothedVel:Lerp(targetVel, alpha)
        if smoothedVel.Magnitude < 0.5 then smoothedVel = Vector3.zero end

        bodyVel.Velocity = smoothedVel
        bodyGyr.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.CFrame.LookVector)
    end)
end
local function StopFly()
    FlyEnabled = false
    if bodyVel then bodyVel:Destroy(); bodyVel = nil end
    if bodyGyr then bodyGyr:Destroy(); bodyGyr = nil end
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

