            if not blackSaved[Window.Root] then blackSaved[Window.Root] = Window.Root.BackgroundColor3 end
            Window.Root.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        end)
    end
    for _, d in ipairs(hub:GetDescendants()) do
        paintBlackOne(d)
    end
end

local function setPaint(mode, quiet)
    local hub = getHub()
    if not hub then return end
    for _, d in ipairs(hub:GetDescendants()) do
        if not paintSaved[d] then
            paintSaved[d] = {
                stroke = d:IsA("UIStroke") and d.Color or nil,
                bg = d:IsA("GuiObject") and d.BackgroundColor3 or nil,
                text = (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and d.TextColor3 or nil,
            }
        end
        local o = paintSaved[d]
        if d:IsA("UIStroke") then
            if mode == "outline" or mode == "full" then
                d.Color = outlineColor
            else
                d.Color = o.stroke
            end
        elseif d:IsA("GuiObject") and o.bg then
            if d.BackgroundTransparency < 1 then
                if mode == "full" then
                    d.BackgroundColor3 = GREEN
                else
                    d.BackgroundColor3 = o.bg
                end
            end
        end
        if o.text then
            if mode == "full" then
                d.TextColor3 = Color3.new(0, 0, 0)
            else
                d.TextColor3 = o.text
            end
        end
    end
end

local function applyPaint(mode)
