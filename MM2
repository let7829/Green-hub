local function pathToPosition(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum then return false end

    farmingActive = true
    hum.WalkSpeed = FarmWalkSpeed

    local path = PathfindingService:CreatePath({
        AgentRadius = 2.5,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentMaxSlope = 45,
        WaypointSpacing = 4, -- Smaller spacing to hug walls and avoid obstacles
    })

    local isBlocked = false
    local blockConn
    blockConn = path.Blocked:Connect(function()
        isBlocked = true
    end)

    local success, err = pcall(function()
        path:ComputeAsync(hrp.Position, targetPos)
    end)

    if not success or path.Status ~= Enum.PathStatus.Success then
        if blockConn then blockConn:Disconnect() end
        farmingActive = false
        return false
    end

    local waypoints = path:GetWaypoints()
    if #waypoints < 2 then
        if blockConn then blockConn:Disconnect() end
        farmingActive = false
        return false
    end

    for i = 2, #waypoints do
        if not AutoFarmEnabled and not farmingActive then 
            if blockConn then blockConn:Disconnect() end
            farmingActive = false
            return false 
        end
        if isBlocked then
            if blockConn then blockConn:Disconnect() end
            farmingActive = false
            return false 
        end

        local wp = waypoints[i]
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then
            if blockConn then blockConn:Disconnect() end
            farmingActive = false
            return false
        end

        if wp.Action == Enum.PathWaypointAction.Jump then
            h.Jump = true
        end

        h:MoveTo(wp.Position)

        local timeout = tick() + 3
        local lastPos = hrp.Position
        local stuckCounter = 0

        while tick() < timeout do
            if not AutoFarmEnabled and not farmingActive then 
                if blockConn then blockConn:Disconnect() end
                farmingActive = false
                return false 
            end
            if isBlocked then
                if blockConn then blockConn:Disconnect() end
                farmingActive = false
                return false 
            end
            
            local cc = LocalPlayer.Character
            local rr = cc and cc:FindFirstChild("HumanoidRootPart")
            if not rr then break end
            
            if (rr.Position - wp.Position).Magnitude < 3 then
                break
            end
            
            if (rr.Position - lastPos).Magnitude < 0.2 then
                stuckCounter = stuckCounter + 1
                if stuckCounter >= 3 then
                    h.Jump = true
                end
            else
                stuckCounter = 0
            end
            lastPos = rr.Position
            
            task.wait(0.05)
        end
    end

    if blockConn then blockConn:Disconnect() end
    farmingActive = false
    return true
end

local function walkToCoin(entity)
    if not entity or not entity.part or not entity.part.Parent then return false end
    local reached = pathToPosition(entity.part.Position)
    if reached then
        markCollected(entity)
        return true
    end
    return false
end

