local function GetRoleColor(char)
    if RoleESPEnabled then
        local cached = ResolveRoleFromCache(char)
        if cached == "Murderer" then return Color3.fromRGB(255,60,60)
        elseif cached == "Sheriff" then return Color3.fromRGB(80,150,255) end
        local murderer = GetMurdererV1()
        local sheriff = GetSheriffV1()
        if char == murderer then return Color3.fromRGB(255,60,60)
        elseif char == sheriff then return Color3.fromRGB(80,150,255) end
    end
    return Color3.fromRGB(0,255,0)
end

local function ApplyChams(char,color)
    if not char or not char.Parent then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local existing = char:FindFirstChild("ChamsESP")
    if existing then
        if existing.Adornee ~= char then existing.Adornee = char end
        existing.FillColor = color
        existing.OutlineColor = color
        existing.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        return
    end
    local h = Instance.new("Highlight")
    h.Name = "ChamsESP"
    h.FillTransparency = 0.6
    h.OutlineTransparency = 0.1
    h.FillColor = color
    h.OutlineColor = color
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee = char
    h.Parent = char
end

