    if existing then
        local r = existing.CornerRadius
        if r.Scale < 0.5 and r.Offset < 12 then
            existing.CornerRadius = UDim.new(0, 12)
        end
        return
    end
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 12)
    c.Parent = d
end

