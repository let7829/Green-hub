local function markCollected(entity)
    if not entity.key then return end
    collectedCoins[entity.key] = true
    local target = entity.model or entity.part
    if not target or not target.Parent then return end
    if target:FindFirstChild("CollectedCoin") then return end
    local h = Instance.new("Highlight")
    h.Name = "CollectedCoin"
    h.FillColor = Color3.fromRGB(0, 255, 100)
    h.FillTransparency = 0.4
    h.OutlineColor = Color3.fromRGB(0, 255, 100)
    h.OutlineTransparency = 0
    h.Parent = target
end

local function getNextUncollectedEntity()
    local entities = getCoinEntities()
    for _, entity in ipairs(entities) do
        if not collectedCoins[entity.key] and entity.part and entity.part.Parent then
            return entity
        end
    end
    return nil
end

