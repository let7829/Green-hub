UIS.InputBegan:Connect(function(i, gp)
    if gp or not KeybindsEnabled then return end
    if WaitingForKey then
        if i.UserInputType == Enum.UserInputType.Keyboard then
            HotkeyKey = i.KeyCode
            pcall(function() hotkeyButton:SetTitle("GUI Hotkey: " .. HotkeyKey.Name) end)
            WaitingForKey = false
            SaveAllSettings()
        end
        return
    end
    if WaitingForXrayKey then
        if i.UserInputType == Enum.UserInputType.Keyboard then
            XrayKey = i.KeyCode
            pcall(function() xrayKeyButton:SetTitle("Xray Hotkey: " .. XrayKey.Name) end)
            WaitingForXrayKey = false
            SaveAllSettings()
        end
        return
    end
    if i.KeyCode == XrayKey then
        XrayEnabled = not XrayEnabled
        if xrayToggle then xrayToggle:SetValue(XrayEnabled) end
        if XrayEnabled then EnableXray() else DisableXray() end
        SaveAllSettings()
    elseif i.KeyCode == Enum.KeyCode.F then
        FlyEnabled = not FlyEnabled
        if Options.Fly then Options.Fly:SetValue(FlyEnabled) end
        if FlyEnabled then StartFly() else StopFly() end
        SaveAllSettings()
    elseif i.KeyCode == Enum.KeyCode.N then
        NoclipEnabled = not NoclipEnabled
        if Options.Noclip then Options.Noclip:SetValue(NoclipEnabled) end
        SaveAllSettings()
    elseif i.KeyCode == Enum.KeyCode.J then
        InfJumpEnabled = not InfJumpEnabled
        if Options.InfJump then Options.InfJump:SetValue(InfJumpEnabled) end
        SaveAllSettings()
    elseif i.KeyCode == CoinGrabKey then
        actionCoinGrab()
    elseif i.KeyCode == GodModeKey then
        GodModeEnabled = not GodModeEnabled
        if Options.Godmode then Options.Godmode:SetValue(GodModeEnabled) end
        if GodModeEnabled then applyGodmode() end
        SaveAllSettings()
    elseif i.KeyCode == TeleportGunKey then
        actionTeleportGun()
    end
end)

