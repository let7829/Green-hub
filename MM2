local function aimbotFunction()
    if not AimbotEnabled then return end
    if AimbotHoldKey and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    local char = LocalPlayer.Character
    if not char then return end
    local myHead = char:FindFirstChild("Head")
    if not myHead then return end

    local targets = {}
    if AimbotTarget == "Murderer" then
        local m = GetMurdererV1()
        if m and m:FindFirstChild("Head") then table.insert(targets, m.Head) end
    elseif AimbotTarget == "Sheriff" then
        local s = GetSheriffV1()
        if s and s:FindFirstChild("Head") then table.insert(targets, s.Head) end
    else
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local h = plr.Character:FindFirstChild("Head")
                if h then table.insert(targets, h) end
            end
        end
    end

    local nearest, nearestDist = nil, math.huge
    for _, head in ipairs(targets) do
        local dist = (myHead.Position - head.Position).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearest = head
        end
    end

    if nearest then
        local cam = workspace.CurrentCamera
        local targetCFrame = CFrame.new(cam.CFrame.Position, nearest.Position)
        cam.CFrame = cam.CFrame:Lerp(targetCFrame, 0.25)
    end
end

local function collectCoins()
    for i = 1, 15 do
        if not AutoFarmEnabled then return end
        if not isAlive() then return end
        local entity = getNextUncollectedEntity()
        if not entity then return end
        if not walkToCoin(entity) then return end
        task.wait(0.2)
    end
end

local autoFarmActive = false
local function autoFarmLoop()
    if autoFarmActive then return end
    autoFarmActive = true
    while AutoFarmEnabled do
        task.wait(0.5)
        if not AutoFarmEnabled then break end
        if not isAlive() then continue end
        local char = LocalPlayer.Character
        if not char then continue end
        local localRole = RoleCache[LocalPlayer]
        if not localRole then
            if char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife") then localRole = "Murderer"
            elseif char:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun") then localRole = "Sheriff"
            else localRole = "Innocent" end
        end
        if localRole == "Murderer" then
            equipKnife()
            if not killAllActive then actionKillAll() end
        elseif localRole == "Sheriff" then
            local murderer = GetMurdererV1()
            if murderer then
                local hum = murderer:FindFirstChildWhichIsA("Humanoid")
                if hum and hum.Health > 0 then
                    hum.Health = 0
                    notify("Auto Farm", "Killed murderer", 2)
                end
            end
        else
            if not killAllActive then collectCoins() end
            local gun = workspace:FindFirstChild("GunDrop", true)
            if gun and isAlive() then
                task.wait(1)
                if not isAlive() or not AutoFarmEnabled then continue end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local target = gun:IsA("BasePart") and gun or gun:FindFirstChildWhichIsA("BasePart")
                    if target then
                        hrp.CFrame = target.CFrame + Vector3.new(0,2,0)
                        task.wait(0.5)
                        if not isAlive() or not AutoFarmEnabled then continue end
                        local murderer = GetMurdererV1()
                        if murderer then
                            local hum = murderer:FindFirstChildWhichIsA("Humanoid")
                            if hum and hum.Health > 0 then
                                hum.Health = 0
                                notify("Auto Farm", "Shot murderer", 2)
                            end
                        end
                    end
                end
            end
        end
    end
    autoFarmActive = false
end

local roleNotifyActive = false
local function roleNotifyLoop()
    if roleNotifyActive then return end
