local function loadStoreIds()
    if storeIds then return storeIds end
    local ids, count = {}, 0
    local conn = NPCDialog.PromptChat.OnClientEvent:Connect(function(_, npc)
        if not ids[npc.Name] then
            ids[npc.Name] = npc.ID
            count += 1
        end
    end)
