local activePress

local function onScreenState(item)
    local o = Options[item.Key]
    return o and o.Value == true
end

local function toggleFunction(item)
    local o = Options[item.Key]
    if o then o:SetValue(not o.Value) end
end

local function matches(p, input)
    if p.input.UserInputType == Enum.UserInputType.MouseButton1 then
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseMovement
    end
    return input == p.input
end

local function bindPress(btn, item)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if activePress then return end
        local press = {
            btn = btn, item = item, input = input, dragging = false,
            start = input.Position, origin = btn.Position,
        }
        activePress = press
        task.delay(0.2, function()
            if activePress == press then press.dragging = true end
        end)
    end)
end

track(UIS.InputChanged:Connect(function(input)
    local p = activePress
    if not p or not p.dragging or not matches(p, input) then return end
    local d = input.Position - p.start
    p.btn.Position = UDim2.new(
        p.origin.X.Scale, p.origin.X.Offset + d.X,
        p.origin.Y.Scale, p.origin.Y.Offset + d.Y
    )
end))

track(UIS.InputEnded:Connect(function(input)
    local p = activePress
    if not p or not matches(p, input) then return end
    activePress = nil
    if not p.dragging then toggleFunction(p.item) end
end))

