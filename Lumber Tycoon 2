local autoChopOn = false
local CHOP_RANGE = 80
local MAX_AT_ONCE = 5
local CHOP_TREE_KIND = "All"
local choppingNow = {}
local chopFailed = {}
local activeCount = 0
local chopLoopId = 0

local function treeFree(t)
    local o = t:FindFirstChild("Owner")
    return not o or o.Value == nil or o.Value == LocalPlayer
end

local function nearbyTrees(count)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local list = {}
    for _, region in ipairs(workspace:GetChildren()) do
        if region.Name == "TreeRegion" then
            for _, t in ipairs(region:GetChildren()) do
                if t:IsA("Model") and t:FindFirstChild("CutEvent") and t:FindFirstChild("TreeClass")
                    and t.TreeClass.Value ~= "LoneCave" and not choppingNow[t]
                    and (chopFailed[t] or 0) < tick()
                    and treeFree(t)
                    and (CHOP_TREE_KIND == "All" or t.TreeClass.Value == CHOP_TREE_KIND) then
                    local d = (t:GetPivot().Position - hrp.Position).Magnitude
                    if d <= CHOP_RANGE then table.insert(list, {tree = t, dist = d}) end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    local out = {}
    for i = 1, math.min(count, #list) do out[i] = list[i].tree end
    return out
end

local function chopTree(tree, loopId)
    local gotAnyLog = false
    pcall(function()
        local clas = tree.TreeClass.Value
        local lastLog = tick()
        local startTime = tick()
        local gotLog = false
        local logConn = workspace.LogModels.ChildAdded:Connect(function(l)
            local o = l:FindFirstChild("Owner")
            if o and o.Value == LocalPlayer then
                lastLog = tick()
                gotLog = true
                gotAnyLog = true
            end
        end)
        while autoChopOn and chopLoopId == loopId and _G.MasterActive do
            if not tree.Parent or not tree:FindFirstChild("CutEvent") then break end
            local ax = getEquippedOrBackpackAxe()
            if not ax then
                task.wait(0.5)
            else
                local stats = getAxStats(ax.ToolName.Value, clas)
                if not stats then
                    task.wait(0.5)
                else
                    ReplicatedStorage.Interaction.RemoteProxy:FireServer(tree.CutEvent, {
                        tool = ax, height = 0.3, faceVector = Vector3.new(1, 0, 0), sectionId = 1,
                        hitPoints = stats.Damage, cooldown = stats.SwingCooldown, cuttingClass = "Axe",
                    })
                    task.wait(stats.SwingCooldown)
                end
            end
            if gotLog and tick() - lastLog > 10 then break end
            if tick() - startTime > 90 then break end
        end
        logConn:Disconnect()
    end)
    if not gotAnyLog and tree.Parent and tree:FindFirstChild("CutEvent") then
        chopFailed[tree] = tick() + 5
    else
        chopFailed[tree] = nil
    end
    choppingNow[tree] = nil
    activeCount -= 1
end

