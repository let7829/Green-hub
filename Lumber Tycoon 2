local function styleHub()
    task.wait(1)
    local hub = getHub()
    if not hub then return end

    local function round(obj, radius)
        if not obj:FindFirstChildOfClass("UICorner") then
            Instance.new("UICorner", obj).CornerRadius = UDim.new(0, radius)
        end
    end

    for _, d in ipairs(hub:GetDescendants()) do
        if d:IsA("Frame") and d.AbsoluteSize.X > 400 then
            d.BackgroundColor3 = Color3.new(0, 0, 0)
            d.BackgroundTransparency = 0
            round(d, 12)
        end
    end

    local root, biggest = nil, 0
    for _, c in ipairs(hub:GetChildren()) do
        if c:IsA("GuiObject") and c.AbsoluteSize.X > biggest then
            root = c
            biggest = c.AbsoluteSize.X
        end
    end
    if root then
        round(root, 12)
        root.ClipsDescendants = true
    end

    local PM = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"))
    local Controls = PM:GetControls()
    if root then
        root.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                Controls:Disable()
            end
        end)
    end
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            Controls:Enable()
        end
    end)

    local outlines = {
        {"Bring ",      Color3.fromRGB(139, 90, 43)},
        {"TP",          Color3.fromRGB(0, 150, 255)},
        {"Load Slot",   Color3.fromRGB(0, 255, 150)},
        {"Save Slot",   Color3.fromRGB(0, 150, 255)},
        {"Select Slot", Color3.fromRGB(150, 150, 0)},
        {"Sell",        Color3.fromRGB(255, 50, 50)},
        {"Delete",      Color3.fromRGB(200, 50, 50)},
        {"Destroy",     Color3.fromRGB(255, 0, 0)},
        {"Axe Dupe",    Color3.fromRGB(255, 100, 0)},
        {"Infinite",    Color3.fromRGB(0, 180, 255)},
    }
    for _, d in ipairs(hub:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("TextLabel") then
            for _, rule in ipairs(outlines) do
                if d.Text:sub(1, #rule[1]) == rule[1] then
                    local target = d:IsA("TextButton") and d or d.Parent
                    if target and not target:FindFirstChild("ColorOutline") then
                        round(target, 9)
                        local s = Instance.new("UIStroke")
                        s.Name = "ColorOutline"
                        s.Color = rule[2]
                        s.Thickness = 2
                        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                        s.Parent = target
                    end
                    break
                end
            end
        end
    end
end

