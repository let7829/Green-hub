local notifyLast = {}
local function notify(title, content, dur)
    local key = tostring(title) .. "|" .. tostring(content)
    local now = tick()
    if notifyLast[key] and now - notifyLast[key] < 1.5 then return end
    notifyLast[key] = now
    Fluent:Notify({Title = title, Content = content or "", Duration = dur or 3})
end

