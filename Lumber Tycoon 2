local autoFarmWoodType = "Generic"
local farmStatus = Tabs.Farm:AddParagraph({Title = "Farm Status", Content = "OFF"})

Tabs.Farm:AddDropdown("FarmWood", {
    Title = "Target Wood",
    Values = {"Generic","Oak","Birch","Cherry","Walnut","Fir","Pine","Maple","Volcano","Frost","GoldSwampy","Koa","Palm","CaveCrawler","GreenSwampy"},
    Multi = false, Default = 1,
    Callback = function(v) autoFarmWoodType = v end,
})

local autoFarmActive = false
Tabs.Farm:AddToggle("AutoFarm", {
    Title = "Auto Farm", Default = false,
    Callback = function(state)
        autoFarmActive = state
        if not state then
            farmStatus:SetDesc("OFF")
            return
        end
        task.spawn(function()
            while autoFarmActive and _G.MasterActive do
                pcall(function()
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end
                    local curpos = hrp.CFrame
                    local target = getTreeOfClass(autoFarmWoodType)
                    local ax
                    for _, v in next, LocalPlayer.Backpack:GetChildren() do
                        if v:FindFirstChild("ToolName") then ax = v break end
                    end
                    if not ax then
                        for _, v in pairs(char:GetChildren()) do
                            if v:FindFirstChild("ToolName") then ax = v break end
                        end
                    end
                    if not (target and ax) then
                        farmStatus:SetDesc("No tree or axe found")
                        task.wait(2)
                        return
                    end
                    farmStatus:SetDesc("Cutting " .. autoFarmWoodType)
                    local stats = getAxStats(ax.ToolName.Value, autoFarmWoodType)
                    if not stats then
                        farmStatus:SetDesc("No axe stats")
                        return
                    end
                    local newLog
                    local con = workspace.LogModels.ChildAdded:Connect(function(l)
                        task.wait()
                        if l:FindFirstChild("Owner") and l.Owner.Value == LocalPlayer then newLog = l end
                    end)
                    local lp = RunService.Heartbeat:Connect(function()
                        hrp.CFrame = target.WoodSection.CFrame + Vector3.new(5, 3, 0)
                    end)
                    local timeout = 0
                    repeat
                        ReplicatedStorage.Interaction.RemoteProxy:FireServer(target.CutEvent, {
                            tool = ax, height = 0.3, faceVector = Vector3.new(1, 0, 0), sectionId = 1,
                            hitPoints = stats.Damage, cooldown = stats.SwingCooldown, cuttingClass = "Axe",
                        })
                        task.wait(stats.SwingCooldown)
                        timeout += stats.SwingCooldown
                    until newLog ~= nil or timeout > 30
                    lp:Disconnect()
                    con:Disconnect()
                    task.wait(0.2)
                    if newLog then
                        farmStatus:SetDesc("Bringing log")
                        for i = 1, 60 do
                            ReplicatedStorage.Interaction.ClientIsDragging:FireServer(newLog)
                            newLog:PivotTo(curpos)
                            task.wait()
                        end
                    end
                    hrp.CFrame = curpos
                    farmStatus:SetDesc("Selling")
                    sellEverything()
                    task.wait(2)
                    farmStatus:SetDesc("Farming " .. autoFarmWoodType)
                end)
            end
            farmStatus:SetDesc("OFF")
        end)
    end,
})

