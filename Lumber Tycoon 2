local ultraOn = false
local ultraSaved = {}

local function setProp(inst, prop, value)
    if not ultraSaved[inst] then ultraSaved[inst] = {} end
    if ultraSaved[inst][prop] == nil then
        ultraSaved[inst][prop] = inst[prop]
    end
    pcall(function() inst[prop] = value end)
end

local function restoreUltra()
    for inst, props in pairs(ultraSaved) do
        for prop, value in pairs(props) do
            pcall(function() inst[prop] = value end)
        end
    end
    table.clear(ultraSaved)
end

local function neonPart(part)
    local char = LocalPlayer.Character
    if char and part:IsDescendantOf(char) then return end
    setProp(part, "Material", Enum.Material.Neon)
    setProp(part, "Color", GREEN)
end

local function applyGameUI()
    local hub = getHub()
    for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui ~= hub and not gui.Name:find("GreenHub") then
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    setProp(d, "TextColor3", GREEN)
                elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
                    setProp(d, "ImageColor3", GREEN)
                elseif d:IsA("Frame") and d.BackgroundTransparency < 1 then
                    setProp(d, "BackgroundColor3", GREEN)
                end
            end
        end
    end
end

local function applyUltra(on)
    ultraOn = on
    if on then
        applyGameUI()
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("BasePart") then neonPart(d) end
        end
        dc(ultraConn)
        ultraConn = workspace.DescendantAdded:Connect(function(d)
            if ultraOn and d:IsA("BasePart") then neonPart(d) end
        end)
    else
        dc(ultraConn)
        ultraConn = nil
        restoreUltra()
    end
end

