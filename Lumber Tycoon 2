local CFG_DIR = "GreenHub"
local CFG_SUB = "GreenHub/configs"
local CFG_AUTO = "GreenHub/autosave.json"
local CFG_META = "GreenHub/meta.json"
local fsOk = type(writefile) == "function" and type(readfile) == "function"
    and type(isfile) == "function" and type(isfolder) == "function"
    and type(makefolder) == "function" and type(listfiles) == "function"
local CFG_SKIP = {ConfigName = true, ConfigList = true, AutoSaveCfg = true}
local loadingCfg = false
local cfgReady = false
local cfgDefaults = {}

if fsOk then
    pcall(function()
        if not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
        if not isfolder(CFG_SUB) then makefolder(CFG_SUB) end
    end)
end

local function writeJson(path, data)
    if not fsOk then return false end
    local ok = pcall(function() writefile(path, HttpService:JSONEncode(data)) end)
    return ok
end

local function readJson(path)
    if not fsOk then return nil end
    local ok, res = pcall(function()
        if not isfile(path) then return nil end
        return HttpService:JSONDecode(readfile(path))
    end)
    if ok then return res end
end

local meta = readJson(CFG_META) or {}
if meta.autosave == nil then meta.autosave = true end
if type(meta.autoload) ~= "string" then meta.autoload = "" end

local function encodeValue(v)
    if typeof(v) == "Color3" then
        return {__c3 = true, r = v.R, g = v.G, b = v.B}
    end
    return v
end

local function collectConfig()
    local t = {}
    for name, opt in pairs(Options) do
        if not CFG_SKIP[name] and type(opt) == "table" and opt.Value ~= nil then
            t[name] = encodeValue(opt.Value)
        end
    end
    return t
end

local function snapshot()
    local t = collectConfig()
    local names = {}
    for n in pairs(t) do names[#names + 1] = n end
    table.sort(names)
    local parts = {}
    for _, n in ipairs(names) do
        local v = t[n]
        parts[#parts + 1] = n .. "=" .. (type(v) == "table" and HttpService:JSONEncode(v) or tostring(v))
    end
    return table.concat(parts, "|"), t
end

local function applyConfig(t)
    loadingCfg = true
    local names = {}
    for name in pairs(t) do table.insert(names, name) end
    table.sort(names)
    for _, name in ipairs(names) do
        local opt = Options[name]
        local v = t[name]
        if opt and not CFG_SKIP[name] then
            pcall(function()
                if type(v) == "table" and v.__c3 then
                    local c = Color3.new(v.r, v.g, v.b)
                    if opt.SetValueRGB then opt:SetValueRGB(c) else opt:SetValue(c) end
                elseif type(v) == "table" or opt.Value ~= v then
                    opt:SetValue(v)
                end
            end)
        end
    end
    loadingCfg = false
end

local function listConfigs()
    local out = {}
    if not fsOk then return out end
    pcall(function()
        for _, path in ipairs(listfiles(CFG_SUB)) do
            local n = tostring(path):match("([^/\\]+)%.json$")
            if n then table.insert(out, n) end
        end
    end)
    table.sort(out)
    return out
end

local function cleanName(s)
    s = tostring(s or ""):gsub("[^%w _%-]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    return s
end

