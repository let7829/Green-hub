local function getFolder(itemName)
    for _, folder in ipairs(ClientItemInfo:GetChildren()) do
        if (folder:FindFirstChild("ItemName") and folder.ItemName.Value == itemName) or folder.Name == itemName then
            return folder
        end
    end
end

local function findStoreItem(name)
    for _, model in ipairs(workspace.Stores:GetChildren()) do
        if model.Name == "ShopItems" then
            for _, item in ipairs(model:GetChildren()) do
                if item:FindFirstChild("Owner") and item.Owner.Value == nil
                    and item:FindFirstChild("BoxItemName") and item.BoxItemName.Value == name then
                    return item
                end
            end
        end
    end
end

local function findCounter(item)
    local best, bestDist = nil, math.huge
    for _, store in ipairs(workspace.Stores:GetChildren()) do
        local counter = store:FindFirstChild("Counter")
        if counter then
            local d = (counter.Position - item.Main.Position).Magnitude
            if d < bestDist then best, bestDist = counter, d end
        end
    end
    return best
end

local function dragTo(model, cf)
    for _ = 1, 60 do
        if _G.AbortAction then break end
        ReplicatedStorage.Interaction.ClientIsDragging:FireServer(model)
        model:PivotTo(cf)
        task.wait()
    end
end

local function buyOne(name)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local folder = getFolder(name)
    local item = findStoreItem(folder and folder.Name or name)
    if not item then
        notify("Buy", "No " .. name .. " in stock", 3)
        return false
    end
    local counter = findCounter(item)
    if not counter then
        notify("Buy", "Counter not found", 3)
        return false
    end

    local startCF = hrp.CFrame
    local ids = loadStoreIds()
    local npcName = nil
    for _, p in ipairs(counter.Parent:GetDescendants()) do
        if p.Name == "Head" and p.Parent and p.Parent:IsA("Model") then npcName = p.Parent break end
    end

    hrp.CFrame = item.Main.CFrame + Vector3.new(5, 3, 5)
    task.wait(0.8)

    local bought
    local conn = workspace.PlayerModels.ChildAdded:Connect(function(obj)
        local owner = obj:WaitForChild("Owner", 1)
        local itemName = obj:WaitForChild("ItemName", 1)
        local purchased = obj:WaitForChild("PurchasedBoxItemName", 1)
        if owner and owner.Value == LocalPlayer and folder
            and ((itemName and itemName.Value == folder.Name) or (purchased and purchased.Value == folder.Name)) then
            bought = obj
        end
    end)

    dragTo(item, counter.CFrame + Vector3.new(0, counter.Size.Y * item.Main.Size.Y / 2, 0))

    local tries = 0
    repeat
        task.wait()
        tries += 1
        if npcName and ids[npcName.Name] then
            pcall(function()
                NPCDialog.PlayerChatted:InvokeServer({ID = ids[npcName.Name]}, "ConfirmPurchase")
            end)
        end
    until bought or tries > 40 or _G.AbortAction

    conn:Disconnect()

    if bought then
        local bHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if bHrp then
            bHrp.CFrame = bought:GetPivot() + Vector3.new(0, 5, 0)
            task.wait(0.3)
        end
        dragTo(bought, startCF)
        notify("Buy", "Bought " .. name, 3)
    else
        notify("Buy", "Purchase did not go through", 3)
    end
    hrp.CFrame = startCF
    return bought ~= nil
end

