local function toggleSelect(model)
    if selectedItems[model] then
        selectedItems[model]:Destroy()
        selectedItems[model] = nil
    else
        local h = Instance.new("Highlight")
        h.FillTransparency = 1
        h.OutlineColor = Color3.fromRGB(0, 255, 255)
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = model
        h.Parent = model
        selectedItems[model] = h
    end
end

local function isBringable(m)
    if m.Name:sub(1, 6) == "Loose_" then return true end
    if m:FindFirstChild("TreeClass") then return true end
    if m:FindFirstChild("BoxItemName") then return true end
    if m:FindFirstChild("PurchasedBoxItemName") then return true end
    if m.Parent == workspace.PlayerModels and (m:FindFirstChild("Owner") or m:FindFirstChild("ItemName")) then
        return true
    end
    return false
end

local function bringableModel(part)
    local m = part and part:FindFirstAncestorOfClass("Model")
    while m do
        if isBringable(m) then return m end
        m = m:FindFirstAncestorOfClass("Model")
    end
end

