local function AddSlider(p, t, mn, mx, def, cb)
    local v = def or mn
    local f = BaseElement(p, 50)
    local l = Instance.new("TextLabel", {Size = UDim2.new(1, -100, 0, 20), Position = UDim2.new(0, 15, 0, 8), BackgroundTransparency = 1, Text = t, TextColor3 = C_TEXT, TextSize = 14, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = f})
    local vt = Instance.new("TextLabel", {Size = UDim2.new(0, 50, 0, 20), Position = UDim2.new(1, -65, 0, 8), BackgroundTransparency = 1, Text = tostring(v), TextColor3 = C_SUBTEXT, TextSize = 14, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Right, Parent = f})
    local tr = Instance.new("Frame", {Size = UDim2.new(1, -30, 0, 4), Position = UDim2.new(0, 15, 0, 35), BackgroundColor3 = C_STROKE, Parent = f})
    Instance.new("UICorner", tr).CornerRadius = UDim.new(1, 0)
    local fl = Instance.new("Frame", {Size = UDim2.new((v - mn) / (mx - mn), 0, 1, 0), BackgroundColor3 = C_ACCENT, Parent = tr})
    Instance.new("UICorner", fl).CornerRadius = UDim.new(1, 0)
    local kn = Instance.new("Frame", {Size = UDim2.fromOffset(12, 12), Position = UDim2.new(1, -6, 0.5, -6), BackgroundColor3 = C_ACCENT, Parent = fl})
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)
    local b = Instance.new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = f})
    
    local drag = false
    local function upd(x)
        local rel = math.clamp((x - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
        v = math.floor(mn + rel * (mx - mn) + 0.5)
        vt.Text = tostring(v)
        fl.Size = UDim2.new(rel, 0, 1, 0)
        if cb then task.spawn(cb, v) end
    end
    tr.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = true upd(i.Position.X) end end)
    UIS.InputChanged:Connect(function(i) if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end end)
    
    return {Value = v, SetValue = function(nv) v = math.clamp(nv, mn, mx) vt.Text = tostring(v) fl.Size = UDim2.new((v - mn) / (mx - mn), 0, 1, 0) if cb then task.spawn(cb, v) end end}
end

