local function loadStoreIds()
    if storeIds then return storeIds end
    local ids, count = {}, 0
    local conn = NPCDialog.PromptChat.OnClientEvent:Connect(function(_, npc)
        if not ids[npc.Name] then ids[npc.Name] = npc.ID; count += 1 end
    end)
    NPCDialog.SetChattingValue:InvokeServer(1)
    local t = tick()
    repeat task.wait() until count >= 12 or tick() - t > 10
    conn:Disconnect()
    NPCDialog.SetChattingValue:InvokeServer(0)
    if next(ids) then storeIds = ids end
    return ids
end

local function getFolder(n)
    for _, f in ipairs(ClientItemInfo:GetChildren()) do
        if (f:FindFirstChild("ItemName") and f.ItemName.Value == n) or f.Name == n then return f end
    end
end
local function findStoreItem(n)
    for _, m in ipairs(workspace.Stores:GetChildren()) do
        if m.Name == "ShopItems" then
            for _, item in ipairs(m:GetChildren()) do
                if item:FindFirstChild("Owner") and item.Owner.Value == nil
                    and item:FindFirstChild("BoxItemName") and item.BoxItemName.Value == n then
                    return item
                end
            end
        end
    end
end
local function findCounter(item)
    local best, bestDist = nil, math.huge
    for _, store in ipairs(workspace.Stores:GetChildren()) do
        local c = store:FindFirstChild("Counter")
        if c then
            local d = (c.Position - item.Main.Position).Magnitude
            if d < bestDist then best, bestDist = c, d end
        end
    end
    return best
end

local function buyOne(name)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local folder = getFolder(name)
    local item = findStoreItem(folder and folder.Name or name)
    if not item then notify("Buy", "No " .. name .. " in stock", 3); return false end
    local counter = findCounter(item)
    if not counter then notify("Buy", "Counter not found", 3); return false end

    local startCF = hrp.CFrame
    local ids = loadStoreIds()
    local npcName
    for _, p in ipairs(counter.Parent:GetDescendants()) do
        if p.Name == "Head" and p.Parent and p.Parent:IsA("Model") then npcName = p.Parent break end
    end

    hrp.CFrame = item.Main.CFrame + Vector3.new(5,3,5)
    task.wait(0.5)

    local bought
    local conn = workspace.PlayerModels.ChildAdded:Connect(function(obj)
        local owner = obj:WaitForChild("Owner", 1)
        local itemName = obj:WaitForChild("ItemName", 1)
        local purchased = obj:WaitForChild("PurchasedBoxItemName", 1)
        if owner and owner.Value == LocalPlayer and folder
            and ((itemName and itemName.Value == folder.Name) or (purchased and purchased.Value == folder.Name)) then
            bought = obj
        end
    end)

    dragTo(item, counter.CFrame + Vector3.new(0, counter.Size.Y * item.Main.Size.Y / 2, 0), 45)

    local tries = 0
    repeat
        task.wait()
        tries += 1
        if npcName and ids[npcName.Name] then
            pcall(function() NPCDialog.PlayerChatted:InvokeServer({ID = ids[npcName.Name]}, "ConfirmPurchase") end)
        end
    until bought or tries > 20 or _G.AbortAction
    conn:Disconnect()

    if bought then
        local bHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if bHrp then
            bHrp.CFrame = bought:GetPivot() + Vector3.new(0,5,0)
            task.wait(0.2)
        end
        dragTo(bought, startCF, 30)
        notify("Buy", "Bought " .. name, 3)
    else
        notify("Buy", "Purchase did not go through", 3)
    end
    hrp.CFrame = startCF
    return bought ~= nil
end

