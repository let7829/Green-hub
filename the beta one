local autoChopOn = false
local CHOP_RANGE = 80
local MAX_AT_ONCE = 5
local CHOP_TREE_KIND = "All"
local chopLoopId = 0

local function treeFree(t)
    local o = t:FindFirstChild("Owner")
    return not o or o.Value == nil or o.Value == LocalPlayer
end

local function nearbyTrees(count)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local list = {}
    for _, region in ipairs(workspace:GetChildren()) do
        if region.Name == "TreeRegion" then
            for _, t in ipairs(region:GetChildren()) do
                if t:IsA("Model") and t:FindFirstChild("CutEvent") and t:FindFirstChild("TreeClass")
                    and t.TreeClass.Value ~= "LoneCave" and treeFree(t)
                    and (CHOP_TREE_KIND == "All" or t.TreeClass.Value == CHOP_TREE_KIND) then
                    local d = (t:GetPivot().Position - hrp.Position).Magnitude
                    if d <= CHOP_RANGE then list[#list+1] = {tree = t, dist = d} end
                end
            end
        end
    end
    table.sort(list, function(a,b) return a.dist < b.dist end)
    local out = {}
    for i = 1, math.min(count, #list) do out[i] = list[i].tree end
    return out
end

