local function fireCut(tree, ax, stats)
    if not (tree and ax and stats) then return end
    if not tree.Parent or not tree:FindFirstChild("CutEvent") then return end
    ReplicatedStorage.Interaction.RemoteProxy:FireServer(tree.CutEvent, {
        tool = ax, height = 0.3, faceVector = Vector3.new(1,0,0), sectionId = 1,
        hitPoints = stats.Damage, cooldown = stats.SwingCooldown, cuttingClass = "Axe",
    })
end

local function dragLogTo(log, targetCF, frames)
    frames = frames or 90
    local lastPos, stuck = nil, 0
    for _ = 1, frames do
        if _G.AbortAction or not log.Parent then break end
        pcall(function() log:PivotTo(targetCF) end)
        local ws = log:FindFirstChild("WoodSection") or log:FindFirstChildWhichIsA("BasePart")
        if ws then
            local diff = targetCF.Position - ws.Position
            if diff.Magnitude > 0.5 then
                for _, p in ipairs(log:GetDescendants()) do
                    if p:IsA("BasePart") then
                        pcall(function() p.CFrame = p.CFrame + diff end)
                    end
                end
            end
            if lastPos and (ws.Position - lastPos).Magnitude < 0.1 then
                stuck += 1
                if stuck > 30 then break end
            else
                stuck = 0
            end
            lastPos = ws.Position
        end
        ReplicatedStorage.Interaction.ClientIsDragging:FireServer(log)
        task.wait()
    end
end

