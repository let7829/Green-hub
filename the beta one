local SELL_CF = CFrame.new(315, -0.296, 85.791) * CFrame.Angles(math.rad(90), 0, 0)
local MAX_SELL = 1
local sellInFlight = 0
local function sellOne(log)
    sellInFlight += 1
    task.spawn(function()
        pcall(function()
            local drag = ReplicatedStorage.Interaction.ClientIsDragging
            local sections = getWoodSections(log)
            if #sections == 0 then return end
            drag:FireServer(log) task.wait() drag:FireServer(log) task.wait() drag:FireServer(log) task.wait()
            local frames, snaps = 0, 0
            while frames < 60 and log.Parent and _G.MasterActive do
                for _, ws in ipairs(sections) do if ws.Parent then ws.CFrame = SELL_CF end end
                drag:FireServer(log) task.wait()
                local still = true
                for _, ws in ipairs(sections) do if ws.Parent and (ws.Position - SELL_CF.Position).Magnitude > 4 then still = false break end end
                if not still then snaps += 1 drag:FireServer(log) task.wait() drag:FireServer(log) task.wait() if snaps > 10 then break end else snaps = 0 end
                frames += 1
            end
            drag:FireServer(log)
        end)
        sellInFlight -= 1
    end)
end
local function sellEverything(silent)
    local queued = 0
    for _, log in ipairs(workspace.LogModels:GetChildren()) do
        if sellInFlight >= MAX_SELL then break end
        if isMyLog(log) then sellOne(log) queued += 1 end
    end
    if not silent then notify("Sell", "Processing " .. queued .. " logs") end
    return queued
end
local function lonecaveTree()
    for _, region in ipairs(workspace:GetChildren()) do
        if region.Name == "TreeRegion" then
            for _, m in ipairs(region:GetChildren()) do if m:IsA("Model") and m:FindFirstChild("CutEvent") and m:FindFirstChild("TreeClass") and m.TreeClass.Value == "LoneCave" and m:FindFirstChild("Owner") and m.Owner.Value == nil then return m end end
        end
    end
end
local function bringWood(woodType)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "No character" end
    local curpos = hrp.CFrame
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:UnequipTools() end) end
    task.wait()
    local tre = getTreeOfClass(woodType)
    if not tre then return false, "No tree found" end
    local ax, stats = getBestAxe(woodType)
    if not ax then return false, "Pick up an axe" end
    if not stats then return false, "No axe stats" end
    local isLone = woodType == "LoneCave"
    if isLone then if ax.ToolName.Value ~= "EndTimesAxe" then return false, "Need EndTimesAxe" end hahaRootJoint() end
    notify("Wood", "Bringing " .. woodType .. "...")
    local ws = tre:FindFirstChild("WoodSection") or tre:FindFirstChildWhichIsA("BasePart")
    local targetPos = ws and (ws.Position + Vector3.new(5,3,0)) or (tre:GetPivot().Position + Vector3.new(5,3,0))
    local loptp
    if not isLone then loptp = RunService.Heartbeat:Connect(function() local c = LocalPlayer.Character local r = c and c:FindFirstChild("HumanoidRootPart") if r and tre.Parent then r.CFrame = CFrame.new(targetPos) end end)
    else hrp.CFrame = CFrame.new(targetPos) end
    task.wait(0.25)
    local newLog
    local logConn = workspace.LogModels.ChildAdded:Connect(function(l) task.wait() local o = l:FindFirstChild("Owner") if o and o.Value == LocalPlayer then newLog = l end end)
    local t0 = tick()
    repeat
        if not tre.Parent or _G.AbortAction or tick() - t0 > 60 then break end
        fireCut(tre, ax, stats)
        task.wait(stats.SwingCooldown)
    until newLog ~= nil
    logConn:Disconnect() if loptp then loptp:Disconnect() end
    if not newLog then local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") if r and not isLone then r.CFrame = curpos end return false, "No log" end
    task.wait(0.15)
    task.spawn(function() for _ = 1, 60 do ReplicatedStorage.Interaction.ClientIsDragging:FireServer(newLog) task.wait() end end)
    task.wait(0.1)
    local wp = newLog:FindFirstChild("WoodSection") if wp then newLog.PrimaryPart = wp end
    if newLog.PrimaryPart then for _ = 1, 60 do if _G.AbortAction then break end pcall(function() newLog.PrimaryPart.Velocity = Vector3.zero newLog:PivotTo(curpos) end) task.wait() end end
    if isLone then
        local ch = LocalPlayer.Character
        if ch then local h = ch:FindFirstChildOfClass("Humanoid") if h then pcall(function() h:UnequipTools() end) end task.wait() local head = ch:FindFirstChild("Head") if head then head:Destroy() end end
        LocalPlayer.CharacterAdded:Wait() task.wait(1.5)
        local nh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") local wp2 = newLog:FindFirstChild("WoodSection")
        if nh and wp2 then nh.CFrame = wp2.CFrame end return true, "Brought"
    end
    local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") if r then r.CFrame = curpos end
    notify("Wood", woodType .. " brought")
    return true, "Brought"
end

