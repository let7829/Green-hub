local function getAxStats(axName, treClas)
    local mod = ReplicatedStorage.AxeClasses:FindFirstChild("AxeClass_" .. axName)
    if not mod then return end
    local ok, s = pcall(function() return require(mod).new() end)
    if not ok or not s then return end
    if s.SpecialTrees and s.SpecialTrees[treClas] then
        for k, v in next, s.SpecialTrees[treClas] do s[k] = v end
    end
    return s
end

local function ownsValue(v)
    if v == nil then return false end
    if v == LocalPlayer or v == LocalPlayer.UserId then return true end
    if v == LocalPlayer.Character then return true end
    return false
end

local function isMyLog(log)
    if not log:IsA("Model") then return false end
    local o = log:FindFirstChild("Owner")
    if not o then return false end
    return ownsValue(o.Value)
end

local function getWoodSections(log)
    local s = {}
    for _, c in ipairs(log:GetDescendants()) do
        if c:IsA("BasePart") and c.Name == "WoodSection" then
            s[#s + 1] = c
        end
    end
    if #s == 0 then
        local p = log:FindFirstChildWhichIsA("BasePart")
        if p then s[1] = p end
    end
    return s
end

local function getModlMass(model)
    local total, sections = 0, 0
    for _, v in next, model:GetDescendants() do
        if v:IsA("BasePart") and v.Name ~= "Leaves" then
            if v.Name == "WoodSection" then sections += 1 end
            total += v.Mass
        end
    end
    return total, sections
end

local function getTreeOfClass(clas)
    local list = {}
    for _, region in next, workspace:GetChildren() do
        if region.Name == "TreeRegion" then
            for _, tree in next, region:GetChildren() do
                if tree:IsA("Model") and tree:FindFirstChild("CutEvent") then
                    local tc = tree:FindFirstChild("TreeClass")
                    local ow = tree:FindFirstChild("Owner")
                    if ow and tc and ow.Value == nil and tc.Value == clas then
                        local mass, secs = getModlMass(tree)
                        if secs > 1 then
                            list[#list + 1] = {tre = tree, mass = mass}
                        end
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.mass > b.mass end)
    return list[1] and list[1].tre or nil
end

