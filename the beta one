local SELL_CF = CFrame.new(315, -0.296, 85.791) * CFrame.Angles(math.rad(90), 0, 0)
local MAX_SELL = 1
local sellInFlight = 0

local function sellOne(log)
    sellInFlight += 1
    task.spawn(function()
        pcall(function()
            local drag = ReplicatedStorage.Interaction.ClientIsDragging
            local sections = getWoodSections(log)
            if #sections == 0 then return end

            drag:FireServer(log)
            task.wait()
            drag:FireServer(log)
            task.wait()
            drag:FireServer(log)
            task.wait()

            local frames = 0
            local snaps = 0
            while frames < 60 and log.Parent and _G.MasterActive do
                for _, ws in ipairs(sections) do
                    if ws.Parent then
                        ws.CFrame = SELL_CF
                    end
                end
                drag:FireServer(log)
                task.wait()

                local still = true
                for _, ws in ipairs(sections) do
                    if ws.Parent and (ws.Position - SELL_CF.Position).Magnitude > 4 then
                        still = false
                        break
                    end
                end
                if not still then
                    snaps += 1
                    drag:FireServer(log)
                    task.wait()
                    drag:FireServer(log)
                    task.wait()
                    if snaps > 10 then break end
                else
                    snaps = 0
                end
                frames += 1
            end

            drag:FireServer(log)
        end)
        sellInFlight -= 1
    end)
end

local function sellEverything(silent)
    local queued = 0
    for _, log in ipairs(workspace.LogModels:GetChildren()) do
        if sellInFlight >= MAX_SELL then break end
        if isMyLog(log) then
            sellOne(log)
            queued += 1
        end
    end
    if not silent then notify("Sell", "Processing " .. queued .. " logs", 2) end
    return queued
end

