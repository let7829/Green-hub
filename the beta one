local function bringWood(woodType)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "No character" end
    local curpos = hrp.CFrame

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:UnequipTools() end) end
    task.wait()

    local tre = getTreeOfClass(woodType)
    if not tre then return false, "No tree found" end

    local ax, stats = getBestAxe(woodType)
    if not ax then return false, "Pick up an axe" end
    if not stats then return false, "No axe stats" end

    local isLone = woodType == "LoneCave"
    if isLone then
        if ax.ToolName.Value ~= "EndTimesAxe" then
            return false, "Need EndTimesAxe for LoneCave"
        end
        hahaRootJoint()
    end

    notify("Wood", "Bringing " .. woodType .. "...")

    local ws = tre:FindFirstChild("WoodSection") or tre:FindFirstChildWhichIsA("BasePart")
    local targetPos = ws and (ws.Position + Vector3.new(5, 3, 0)) or (tre:GetPivot().Position + Vector3.new(5, 3, 0))

    local loptp
    if not isLone then
        loptp = RunService.Heartbeat:Connect(function()
            local c = LocalPlayer.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if r and tre.Parent then
                r.CFrame = CFrame.new(targetPos)
            end
        end)
    else
        hrp.CFrame = CFrame.new(targetPos)
    end
    task.wait(0.25)

    local newLog
    local logConn = workspace.LogModels.ChildAdded:Connect(function(l)
        task.wait()
        local o = l:FindFirstChild("Owner")
        if o and o.Value == LocalPlayer then newLog = l end
    end)

    local t0 = tick()
    repeat
        if not tre.Parent or _G.AbortAction or tick() - t0 > 60 then break end
        fireCut(tre, ax, stats)
        task.wait(stats.SwingCooldown)
    until newLog ~= nil

    logConn:Disconnect()
    if loptp then loptp:Disconnect() end

    if not newLog then
        local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if r and not isLone then r.CFrame = curpos end
        return false, "No log spawned"
    end

    task.wait(0.15)
    task.spawn(function()
        for _ = 1, 60 do
            ReplicatedStorage.Interaction.ClientIsDragging:FireServer(newLog)
            task.wait()
        end
    end)
    task.wait(0.1)

    local wp = newLog:FindFirstChild("WoodSection")
    if wp then newLog.PrimaryPart = wp end
    if newLog.PrimaryPart then
        for _ = 1, 60 do
            if _G.AbortAction then break end
            pcall(function()
                newLog.PrimaryPart.Velocity = Vector3.zero
                newLog:PivotTo(curpos)
            end)
            task.wait()
        end
    end

    if isLone then
        local ch = LocalPlayer.Character
        if ch then
            local h = ch:FindFirstChildOfClass("Humanoid")
            if h then pcall(function() h:UnequipTools() end) end
            task.wait()
            local head = ch:FindFirstChild("Head")
            if head then head:Destroy() end
        end
        LocalPlayer.CharacterAdded:Wait()
        task.wait(1.5)
        local nh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local wp2 = newLog:FindFirstChild("WoodSection")
        if nh and wp2 then nh.CFrame = wp2.CFrame end
        return true, "Lonecave brought"
    end

