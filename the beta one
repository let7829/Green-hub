local function CreateTab(name, iconId)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = C_BG
    btn.Text = ""
    btn.Parent = SidebarScroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    local ind = Instance.new("Frame")
    ind.Name = "Indicator"
    ind.Size = UDim2.new(0, 3, 0, 16)
    ind.Position = UDim2.new(0, 0, 0.5, -8)
    ind.BackgroundColor3 = C_ACCENT
    ind.Visible = false
    ind.Parent = btn
    Instance.new("UICorner", ind).CornerRadius = UDim.new(1, 0)
    
    local ico = Instance.new("ImageLabel")
    ico.Size = UDim2.fromOffset(20, 20)
    ico.Position = UDim2.new(0, 15, 0.5, -10)
    ico.BackgroundTransparency = 1
    ico.Image = iconId
    ico.ImageColor3 = C_SUBTEXT
    ico.Parent = btn
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -45, 1, 0)
    lbl.Position = UDim2.new(0, 45, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = C_SUBTEXT
    lbl.TextSize = 14
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 0)
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.BackgroundTransparency = 1
    frame.Visible = false
    frame.Parent = ContentScroll
    Instance.new("UIListLayout", {Padding = UDim.new(0, 8), Parent = frame})
    
    btn.MouseButton1Click:Connect(function()
        if ActiveTab then
            ActiveTab.Btn.BackgroundColor3 = C_BG
            ActiveTab.Btn.Indicator.Visible = false
            ActiveTab.Lbl.TextColor3 = C_SUBTEXT
            ActiveTab.Ico.ImageColor3 = C_SUBTEXT
            ActiveTab.Frame.Visible = false
        end
        ActiveTab = Tabs[name]
        btn.BackgroundColor3 = C_ELEMENT
        ind.Visible = true
        lbl.TextColor3 = C_TEXT
        ico.ImageColor3 = C_TEXT
        frame.Visible = true
        ContentTitle.Text = name
    end)
    
    Tabs[name] = {Btn = btn, Lbl = lbl, Ico = ico, Frame = frame}
    if not ActiveTab then
        ActiveTab = Tabs[name]
        btn.BackgroundColor3 = C_ELEMENT
        ind.Visible = true
        lbl.TextColor3 = C_TEXT
        ico.ImageColor3 = C_TEXT
        frame.Visible = true
        ContentTitle.Text = name
    end
    return frame
end

