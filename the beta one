local function flyDirection(cam)
    local d = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then d += cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then d += cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.yAxis end
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then d -= Vector3.yAxis end
    local ctl = getFlyControls()
    if ctl then
        local mv = ctl:GetMoveVector()
        if mv.Magnitude > 0.05 then
            d += cam.CFrame.RightVector * mv.X + cam.CFrame.LookVector * -mv.Z
        end
    end
    return d
end

local flyBv, flyBg, flyConn, flyPlat, flyRoot
local vehBv, vehConn, vehRoot

local function stopFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyBv then flyBv:Destroy(); flyBv = nil end
    if flyBg then flyBg:Destroy(); flyBg = nil end
    if flyPlat and flyPlat.Parent then flyPlat.PlatformStand = false end
    flyPlat = nil
    flyRoot = nil
end

local function startFly()
    if flyConn then return true end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    flyRoot = root
    flyBv = Instance.new("BodyVelocity", root)
    flyBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBv.Velocity = Vector3.zero
    flyBg = Instance.new("BodyGyro", root)
    flyBg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyBg.P = 9000
    flyPlat = char:FindFirstChildOfClass("Humanoid")
    if flyPlat then flyPlat.PlatformStand = true end
    flyConn = RunService.RenderStepped:Connect(function()
        local c = LocalPlayer.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if r ~= flyRoot or not flyRoot.Parent then stopFly() return end
        if flyBv.Parent ~= flyRoot then flyBv.Parent = flyRoot end
        if flyBg.Parent ~= flyRoot then flyBg.Parent = flyRoot end
        if flyPlat and flyPlat.Parent and not flyPlat.PlatformStand then
            flyPlat.PlatformStand = true
        end
        local cam = workspace.CurrentCamera
        local d = flyDirection(cam)
        flyBv.Velocity = d.Magnitude > 0 and d.Unit * _G.FlySpeed or Vector3.zero
        flyBg.CFrame = cam.CFrame
    end)
    return true
end

local function stopVehFly()
    if vehConn then vehConn:Disconnect(); vehConn = nil end
    if vehBv then vehBv:Destroy(); vehBv = nil end
