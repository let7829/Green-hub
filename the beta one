end

local paintSaved = setmetatable({}, {__mode = "k"})
local paintMode = "none"
local outlineColor = Color3.fromRGB(0,255,0)
local GREEN = Color3.fromRGB(0,255,0)
local toggleColor = Color3.fromRGB(170,255,50)
local blackActive = false
local blackSaved = setmetatable({}, {__mode = "k"})

local function paintBlackOne(d)
    if not blackActive then return end
    if not d:IsA("GuiObject") then return end
    if d.BackgroundTransparency >= 1 then return end
    if not blackSaved[d] then blackSaved[d] = d.BackgroundColor3 end
    local isTrack = false
    if d:IsA("Frame") and d.ClipsDescendants then
        local c = d:FindFirstChildOfClass("UICorner")
        local sy = d.AbsoluteSize.Y
        if c and c.CornerRadius.Scale >= 0.5 and sy >= 16 and sy <= 36 then isTrack = true end
    end
    d.BackgroundColor3 = isTrack and toggleColor or Color3.fromRGB(0,0,0)
end

local function setBlack(on)
    blackActive = on
    if not on then
        for d, c in pairs(blackSaved) do
            pcall(function() if d and d.Parent then d.BackgroundColor3 = c end end)
        end
        table.clear(blackSaved)
        return
    end
    local hub = getHub()
    if not hub then return end
    if Window.Root then
        if not blackSaved[Window.Root] then blackSaved[Window.Root] = Window.Root.BackgroundColor3 end
        Window.Root.BackgroundColor3 = Color3.fromRGB(0,0,0)
    end
    for _, d in ipairs(hub:GetDescendants()) do paintBlackOne(d) end
end

local function setPaint(mode)
    paintMode = mode
    local hub = getHub()
    if not hub then return end
    for _, d in ipairs(hub:GetDescendants()) do
        if not paintSaved[d] then
            paintSaved[d] = {
                stroke = d:IsA("UIStroke") and d.Color or nil,
                bg = d:IsA("GuiObject") and d.BackgroundColor3 or nil,
                text = (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and d.TextColor3 or nil,
            }
        end
        local o = paintSaved[d]
        if d:IsA("UIStroke") then
            d.Color = (mode == "outline" or mode == "full") and outlineColor or o.stroke
        elseif d:IsA("GuiObject") and o.bg then
            if d.BackgroundTransparency < 1 then
                d.BackgroundColor3 = (mode == "full") and GREEN or o.bg
            end
        end
        if o.text then
            d.TextColor3 = (mode == "full") and Color3.new(0,0,0) or o.text
        end
    end
end

