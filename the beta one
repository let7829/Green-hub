end

local function startVehFly()
    if vehConn then return true end
    local char = LocalPlayer.Character
    local h = char and char:FindFirstChildOfClass("Humanoid")
    local seat = h and h.SeatPart
    if not seat then return false end
    vehRoot = seat
    vehBv = Instance.new("BodyVelocity", seat)
    vehBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    vehBv.Velocity = Vector3.zero
    vehConn = RunService.RenderStepped:Connect(function()
        local c = LocalPlayer.Character
        local hh = c and c:FindFirstChildOfClass("Humanoid")
        local s = hh and hh.SeatPart
        if s ~= vehRoot or not vehRoot.Parent then stopVehFly() return end
