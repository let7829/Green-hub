local function getBestAxe(woodType)
    local list = {}
    for _, a in next, LocalPlayer.Backpack:GetChildren() do
        if a.Name ~= "BlueprintTool" and a:FindFirstChild("ToolName") then
            local s = getAxStats(a.ToolName.Value, woodType)
            if s then list[#list + 1] = {ax = a, stats = s} end
        end
    end
    local char = LocalPlayer.Character
    if char then
        for _, a in next, char:GetChildren() do
            if a:IsA("Tool") and a.Name ~= "BlueprintTool" and a:FindFirstChild("ToolName") then
                local s = getAxStats(a.ToolName.Value, woodType)
                if s then list[#list + 1] = {ax = a, stats = s} end
            end
        end
    end
    if #list == 0 then return nil, nil end
    table.sort(list, function(a, b) return a.stats.Damage > b.stats.Damage end)
    return list[1].ax, list[1].stats
end

